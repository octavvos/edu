# Nusxa oling: cp .env.example .env

# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=change-me-to-a-random-50-char-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database (PostgreSQL 16) ---
POSTGRES_DB=edu
POSTGRES_USER=edu
POSTGRES_PASSWORD=edu
DATABASE_URL=postgres://edu:edu@postgres:5432/edu

# --- Redis ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# --- MinIO (S3-compatible) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=edu-platform
MINIO_ENDPOINT=http://minio:9000
# Brauzerdan ochiladigan (host'ga mapping qilingan) manzil — fayl
# havolalari shu orqali generatsiya qilinadi, ichki "minio:9000" emas.
MINIO_PUBLIC_ENDPOINT=localhost:9000

# --- Eskiz.uz (SMS/OTP) ---
ESKIZ_EMAIL=
ESKIZ_PASSWORD=

# --- Payme ---
PAYME_MERCHANT_ID=
PAYME_SECRET_KEY=
PAYME_TEST_MODE=true

# --- Bunny Stream (video) ---
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=
BUNNY_STREAM_CDN_HOSTNAME=

# --- Firebase Cloud Messaging (push) ---
FCM_SERVER_KEY=

# --- Cloudflare Turnstile (CAPTCHA) ---
CLOUDFLARE_TURNSTILE_SECRET=

# --- SendGrid (email) ---
SENDGRID_API_KEY=
SENDGRID_USERNAME=apikey
SENDGRID_SMTP_HOST=smtp.sendgrid.net

# --- Sentry ---
SENTRY_DSN=

# --- CORS / Frontend ---
CORS_ALLOWED_ORIGINS=http://localhost:3000
FRONTEND_BASE_URL=http://localhost:3000

# --- Frontend (Next.js) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
